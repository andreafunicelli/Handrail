Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\Default%20Settings]
"HostName"=""
"Protocol"="ssh"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\My%20Server]
"HostName"="10.1.2.3"
"Protocol"="ssh"
"PortNumber"=dword:00000898
"UserName"="alice"
"PublicKeyFile"="C:\keys\prod.ppk"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\agent%20box]
"HostName"="bob@agent.example.test"
"Protocol"="ssh"
"PortNumber"=dword:00000016
"TryAgent"=dword:00000001

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\telnet%20box]
"HostName"="t.example.test"
"Protocol"="telnet"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\raw%20box]
"HostName"="r.example.test"
"Protocol"="raw"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\pem%20user]
"HostName"="pem.example.test"
"Protocol"="ssh"
"UserName"="carol"
"PublicKeyFile"="{{DIR}}/id_pem"

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\SshHostKeys]
"ssh-ed25519@22:pem.example.test"="0x1,0x2"
